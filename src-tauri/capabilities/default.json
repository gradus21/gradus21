{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Gradus21",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "biometric:default",
    "biometric:allow-biometric-cipher",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "*://*" },
        { "url": "*://*/*" },
        { "url": "https://*" },
        { "url": "https://*/*" },
        { "url": "https://**" },
        { "url": "http://*" },
        { "url": "http://*/*" },
        { "url": "http://**" }
      ]
    }
  ]
}
