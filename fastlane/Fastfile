default_platform(:ios)

platform :ios do
  desc "Upload metadata and screenshots to App Store Connect"
  lane :upload_metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_P8"]
    )

    review_info = {
      first_name: "Julian",
      last_name: "Kallidat",
      phone_number: "+49 176 12345678",
      email_address: "julian@gradus21.de",
      notes: "Gradus21 nutzt eine lokale Zero-Knowledge Architektur. Zur Prüfung ist kein externer Server-Account notwendig: Sie können direkt im Assistenten einen neuen lokalen Tresor anlegen oder den Offline-Modus nutzen."
    }

    # 1. iOS / iPadOS
    UI.message("--- Uploading for iOS & iPadOS ---")
    deliver(
      api_key: api_key,
      platform: "ios",
      screenshots_path: "./fastlane/screenshots_ios",
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: false,
      force: true,
      run_precheck_before_submit: false,
      ignore_language_directory_validation: true,
      app_review_information: review_info
    )

    # 2. macOS (OSX)
    UI.message("--- Uploading for macOS ---")
    begin
      deliver(
        api_key: api_key,
        platform: "osx",
        screenshots_path: "./fastlane/screenshots_mac",
        skip_binary_upload: true,
        skip_screenshots: false,
        skip_metadata: false,
        force: true,
        run_precheck_before_submit: false,
        ignore_language_directory_validation: true,
        app_review_information: review_info
      )
    rescue => ex
      UI.important("macOS Upload Note: #{ex.message}. Falls die macOS-Plattform in App Store Connect noch nicht per '+' angelegt wurde, kann sie im linken Menü hinzugefügt werden.")
    end
  end
end

platform :mac do
  desc "Fetch or create macOS App Store provisioning profile"
  lane :get_provisioning_profile do
    key_id = ENV["KEY_ID"] || ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id = ENV["ISSUER_ID"] || ENV["APP_STORE_CONNECT_ISSUER_ID"]
    key_content = ENV["API_KEY_P8"] || ENV["APP_STORE_CONNECT_API_KEY_P8"] || ENV["APP_STORE_CONNECT_API_KEY_KEY"]

    if key_id && issuer_id && key_content
      api_key = app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer_id,
        key_content: key_content,
        is_key_content_base64: false
      )
      sigh(
        api_key: api_key,
        platform: "macos",
        app_identifier: "de.gradus21.app",
        output_path: ENV["RUNNER_TEMP"] || ".",
        filename: "embedded.provisionprofile",
        skip_install: true,
        force: false
      )
    else
      UI.user_error!("App Store Connect API key credentials missing.")
    end
  end
end
