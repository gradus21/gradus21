# System-Umgebung (production, test, development)
# In Test- und Produktivsystemen ist die E-Mail-Verifikation für alle Folgebenutzer (außer dem ersten Admin) zwingend erforderlich.
APP_ENV=production

# WebAuthn / Passkey Relying Party Configuration
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Gradus21
WEBAUTHN_RP_ORIGIN=http://localhost:5173
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3080,http://127.0.0.1:5173,http://127.0.0.1:3080

# CORS Configuration (erlaubte Web-Origins für API-Zugriff)
CORS_ALLOWED_ORIGIN=http://localhost:3080,http://localhost:5173

# Rechtliche Angaben (§ 5 DDG Impressum & DSGVO Konfiguration)
