POSTGRES_USER=gradus21
# ACHTUNG: Bitte vor dem Start in Produktivumgebungen zwingend eigene Geheimnisse generieren (z. B. `openssl rand -hex 32`)!
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
POSTGRES_DB=gradus21
POSTGRES_PORT=5435
API_PORT=8080
WEB_PORT=3080
IMAGE_TAG=latest
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
SERVER_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# System-Umgebung (production, test, development)
# In Test- und Produktivsystemen ist die E-Mail-Verifikation für alle Folgebenutzer (außer dem ersten Admin) zwingend erforderlich.
# ACHTUNG: In Produktionsumgebungen (APP_ENV=production) müssen eigene, sichere Schlüssel für JWT_SECRET und SERVER_ENCRYPTION_KEY definiert werden!
APP_ENV=production

# WebAuthn / Passkey Relying Party Configuration
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Gradus21
WEBAUTHN_RP_ORIGIN=http://localhost:5173
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3080,http://127.0.0.1:5173,http://127.0.0.1:3080

# CORS Configuration (erlaubte Web-Origins für API-Zugriff)
CORS_ALLOWED_ORIGIN=http://localhost:3080,http://localhost:5173

# Rechtliche Angaben (§ 5 DDG Impressum & DSGVO Konfiguration)
LEGAL_IMPRESSUM_NAME=Muster-Schulträger / Betreiber
LEGAL_IMPRESSUM_COMPANY=
LEGAL_IMPRESSUM_ADDRESS=Musterstraße 1, 12345 Musterstadt, Deutschland
LEGAL_IMPRESSUM_EMAIL=kontakt@example.org
LEGAL_IMPRESSUM_PHONE=
LEGAL_IMPRESSUM_REPRESENTATIVE=
LEGAL_IMPRESSUM_REGISTER=
LEGAL_IMPRESSUM_VAT_ID=
LEGAL_HOSTING_PROVIDER=Alfahosting GmbH (Ankerstraße 3b, 06108 Halle (Saale))
LEGAL_HOSTING_LOCATION=Leipzig, Deutschland (EU)
LEGAL_DPO_CONTACT=

# AVV (Auftragsverarbeitungsvertrag gem. Art. 28 DSGVO) Konfiguration
# Standardmäßig verweist die App auf den offiziellen Online-Mustervertrag auf gradus21.de
# Wenn Sie Gradus21 selbst hosten, können Sie diese URLs und Hinweise auf eigene Dokumente anpassen:
LEGAL_AVV_URL=https://gradus21.de/avv.html
LEGAL_AVV_DOWNLOAD_URL=https://gradus21.de/downloads/gradus21-muster-avv.pdf
LEGAL_AVV_CUSTOM_TEXT=

# Nutzungsbedingungen (Terms of Service)
# Standardmäßig verweist die App auf die Bedingungen auf gradus21.de (beim Self-Hosting frei konfigurierbar)
LEGAL_TERMS_URL=https://gradus21.de/nutzungsbedingungen.html


